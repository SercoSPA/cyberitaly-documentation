# ci-mon-dash-01 environment — copy to .env and fill in.
# cp .env.example .env
#
# NOTE: most of these values come from scripts you run on db-01 AFTER
# Elasticsearch is up. See the repo README, "Deployment order".

# Must match db-01/.env
STACK_VERSION=8.18.2

# Same 'elastic' password as db-01/.env (used by Heartbeat).
ELASTIC_PASSWORD=CHANGE_ME_elastic_password

# From scripts/05-set-kibana-password.sh
KIBANA_PASSWORD=CHANGE_ME_kibana_system_password

# From scripts/06-create-fleet-token.sh
FLEET_SERVER_SERVICE_TOKEN=CHANGE_ME_fleet_service_token

# From scripts/04-ca-fingerprint.sh (lowercase hex, no colons)
CA_TRUSTED_FINGERPRINT=CHANGE_ME_ca_sha256_fingerprint

# Kibana encryption keys — each must be at least 32 characters.
# Generate three distinct values:  openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_min_32_char_random_string_1
SECURITY_ENCRYPTION_KEY=CHANGE_ME_min_32_char_random_string_2
REPORTING_ENCRYPTION_KEY=CHANGE_ME_min_32_char_random_string_3
