# ci-mon-db-01 environment — copy to .env and fill in.
# cp .env.example .env

# Elastic Stack version (set to the latest 8.x).
STACK_VERSION=8.18.2

# Cluster name.
CLUSTER_NAME=cyberitaly-monitoring

# License: basic (free) or trial.
LICENSE=basic

# Password for the built-in 'elastic' superuser.
# Generate one with:  openssl rand -base64 24
ELASTIC_PASSWORD=CHANGE_ME_elastic_password
